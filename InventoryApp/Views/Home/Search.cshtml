@model InventoryApp.ViewModel.SearchViewModel

<div class="container mt-4" dir="rtl">
    <form asp-action="Search" asp-controller="Home" method="get" class="row g-2 mb-3">
        <div class="col-md-6">
            <input name="q"
                   value="@Model?.Query"
                   class="form-control"
                   placeholder="ابحث عن منتج..." />
        </div>

        <div class="col-md-3">
            <select name="categoryId" class="form-select">
                <option value="">كل الأقسام</option>
                @if (Model?.Categories != null)
                {
                    foreach (var c in Model.Categories)
                    {
                        <option value="@c.Id" selected="@(Model?.CategoryId == c.Id)">@c.Name</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-1">
            <input type="number"
                   step="0.01"
                   name="minPrice"
                   value="@(Model?.MinPrice?.ToString())"
                   class="form-control"
                   placeholder="من" />
        </div>

        <div class="col-md-1">
            <input type="number"
                   step="0.01"
                   name="maxPrice"
                   value="@(Model?.MaxPrice?.ToString())"
                   class="form-control"
                   placeholder="إلى" />
        </div>

        <div class="col-md-1">
            <button class="btn btn-primary w-100">بحث</button>
        </div>
    </form>

    @if ((Model?.Results?.Any() ?? false) == false)
    {
        <div class="alert alert-info">لا توجد نتائج.</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">النتائج</h5>
            <small class="text-muted">إجمالي النتائج: @Model.Total</small>
        </div>

        <div class="row gy-4">
            @foreach (var item in Model.Results)
            {
                <div class="col-xl-4 col-lg-6">
                    <div class="service-item p-3 border rounded-3 h-100" style="width:100%">
                        <div class="mb-2 text-center">
                            <img src="@item.ImageUrl"
                                 alt="@item.Name"
                                 class="img-fluid myProductImage"
                                 style="max-height:220px; object-fit:contain;" />
                        </div>

                        <h4 class="title fs-5 mb-1">
                            <a asp-controller="Home"
                               asp-action="CurrentProduct"
                               asp-route-id="@item.Id"
                               class="stretched-link text-decoration-none">
                                @item.Name
                            </a>
                        </h4>

                        <div class="text-muted small mb-2">
                            @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                            {
                                <span>القسم: @item.CategoryName</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Name))
                        {
                            <p class="description mb-2" style="min-height:48px; overflow:hidden;">
                                @item.Name
                            </p>
                        }

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">السعر: @item.SalePrice</span>
                            <span class="badge bg-@(item.PurchasePrice > item.PurchasePrice ? "success" : "warning")">
                                المتاح: @item.SalePrice
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
