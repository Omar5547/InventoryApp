@model IEnumerable<InventoryApp.ViewModel.VendorViewModel>
@{
    ViewData["Title"] = "Vendors";
}
<h2>Vendors</h2>
<p>
    <a asp-action="Create" class="btn btn-primary">+ Add Vendor</a>
</p>
<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" class="form-control" placeholder="Search by vendor name" value="@Context.Request.Query["search"]" />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Address</th>
            <th>City</th>
            <th>Country</th>
            <th>Fax</th>
            <th>Discount</th>


        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>@item.Address</td>
                <td>@item.City</td>
                <td>@item.Country</td>
                <td>@item.Fax</td>
                <td>@item.Discount</td>






                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>

                </td>

            </tr>

        }
    </tbody>
</table>