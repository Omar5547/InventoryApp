@model InventoryApp.ViewModel.PurchaseOrderViewModel
@{
    ViewData["Title"] = "Create Purchase Order";
}
<div class="container mt-4">
    <h2>Create Purchase Order</h2>


    <form asp-action="Create" method="post">
        <div class="card">
            <div class="card-body">

         
        <div class="form-group mb-3">
            <label asp-for="VendorId" class="form-label">Vendor</label>
           <select asp-for="VendorId" class="form-select" asp-items="Model.VendorList" >
               <option value="">--- Select Vendor ---</option>
           </select>
            <span asp-validation-for="VendorId" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="OrderDate" class="form-label"> Order Date</label>
            <input asp-for="OrderDate" class="form-control" type="date" />
            <span asp-validation-for="OrderDate" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
             <label asp-for="Discount" class="form-label"> Discount</label>
             <input asp-for="Discount" class="form-control" type="number" step="0.01" />
             <span asp-validation-for="Discount" class="text-danger"></span>
        </div>
         <div class="form-group mb-3">
              <label asp-for="NonVendorCosts" class="form-label"> Non-Vendor Costs</label>
              <input asp-for="NonVendorCosts" class="form-control" type="number" step="0.01" />
              <span asp-validation-for="NonVendorCosts" class="text-danger"></span>
          </div>
          <div class="form-group mb-3">
                <label asp-for="Currency" class="form-label"> Currency </label>
                <input asp-for="Currency" class="form-control" />
                 <span asp-validation-for="Currency" class="text-danger"></span>
           </div>
        
        <div class="d-flex gap-2" >
   
             <button type="submit" class="btn btn-success"> Save</button>
              <a asp-action="Index" class="btn btn-secondary">Cancel</a>
         </div>
     </div>
    </div>
    </form>
</div>
@section Scripts {
    
        <partial name="_ValidationScriptsPartial" />

    
}