@model InventoryApp.ViewModel.PurchaseOrderViewModel
@{
    ViewData["Title"] = "Delete Purchase Order";
}
<div class="container mt-4">
    <h2>Delete Purchase Order</h2>
    <div class="alert alert-warning">
        <h4>Are You sure you want to delete this Purchase Order?</h4>
    
        <hr />



    <dl class="row">
        <dt class="col-sm-3">Order ID</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-3">Order Date</dt>
        <dd class="col-sm-9">@Model.OrderDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
            <dt class="col-sm-3">Total Discount</dt>
            <dd class="col-sm-9">@Model.Discount.ToString("C")</dd>

    </dl>
    </div>
    <form asp-action="Delete" method="post">
        <input type="hidden" name="Id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary"> Cancel</a>
    </form>
</div>
