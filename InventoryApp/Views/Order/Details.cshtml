@model InventoryApp.ViewModel.PurchaseOrderViewModel

@{
    ViewData["Title"] = "Purchase Order Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Purchase Order #@Model.Id</h2>
        <div>
            @if (Model.Status == Core.Entities.OrderStatus.Open)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="get" class="d-inline">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
                <form asp-action="Post" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to post this order?');">
                    <input type="hidden" name="locationId" value="1" />
                    <button type="submit" class="btn btn-success">Post</button>
                </form>
            }
            else if (Model.Status == Core.Entities.OrderStatus.Posted)
            {
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this order?');">
                    <button type="submit" class="btn btn-secondary">Cancel</button>
                </form>
            }
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Vendor</dt>
                <dd class="col-sm-9">@Model.VendorName</dd>

                <dt class="col-sm-3">Order Date</dt>
                <dd class="col-sm-9">@Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.Status == Core.Entities.OrderStatus.Open)
                    {
                        <span class="badge bg-warning">Open</span>
                    }
                    else if (Model.Status == Core.Entities.OrderStatus.Posted)
                    {
                        <span class="badge bg-success">Posted</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Canceled</span>
                    }
                </dd>

                <dt class="col-sm-3">Currency</dt>
                <dd class="col-sm-9">@Model.Currency</dd>

                <dt class="col-sm-3">Discount</dt>
                <dd class="col-sm-9">@Model.Discount.ToString("C")</dd>

                <dt class="col-sm-3">Non-Vendor Costs</dt>
                <dd class="col-sm-9">@Model.NonVendorCosts.ToString("C")</dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                <dt class="col-sm-3">Updated At</dt>
                <dd class="col-sm-9">@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
            </dl>
        </div>
    </div>

    <h3 class="mt-4">Order Items</h3>
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Product Name</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Discount (%)</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Qty</td>
                        <td>@item.UnitPrice.ToString("C")</td>
                        <td>@item.Discount%</td>
                        <td>@item.Total.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="4" class="text-end">Total after discount:</th>
                    <th>
                        @{
                            var total = Model.Items.Sum(i => i.Total);
                            var finalTotal = total - Model.Discount + Model.NonVendorCosts;
                        }
                        @finalTotal.ToString("C")
                    </th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>