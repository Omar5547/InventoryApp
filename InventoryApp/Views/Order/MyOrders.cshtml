@model List<InventoryApp.ViewModel.OrderViewModel>
@{
    ViewData["Title"] = "MyOrders";
}

<h2 class="mb-3">MyOrders</h2>
@if(Model == null || !Model.Any())
{
    <div class=" alert alert-info">لا توجد طلبات حتي الآن</div>

}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Date</th>
                
                <th>Status</th>
                <th>Items</th>
                <th>Total </th>
                <th></th>
              

            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>@o.Id</td>
                    <td>@o.Date.ToString("yyy-MM-dd HH:mm")</td>
                    <td>@o.Status</td>
                    <td>@o.ItemsCount</td>
                    <td>@o.Total.ToString("C")</td>
                    <td>
                        <a asp-controller="Order" asp-action="Details" asp-route-id="@o.Id" class="btn-sm btn-primary">
                            Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

