@model InventoryApp.ViewModel.SalesOrderViewModel
@{
    ViewData["Title"] = "Edit Sales Order";
}
<div class="container mt-4">
    <h2>Edit Sales Order</h2>



    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="card">
            <div class="card-body">


                <div class="form-group mb-3">
                    <label asp-for="CustomerId" class="form-label">Customer</label>
                    <select asp-for="CustomerId" class="form-select" asp-items="Model.CustomerList">
                        <option value="">--- Select Customer ---</option>
                    </select>
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="OrderDate" class="form-label"> Order Date</label>
                    <input asp-for="OrderDate" class="form-control" type="date" />
                    <span asp-validation-for="OrderDate" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Discount" class="form-label"> Discount</label>
                    <input asp-for="Discount" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Discount" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="Currency" class="form-label"> Currency </label>
                    <input asp-for="Currency" class="form-control" />
                    <span asp-validation-for="Currency" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-success"> Save</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    
        <partial name="_ValidationScriptsPartial" />

    
}