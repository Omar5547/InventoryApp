@model List<InventoryApp.ViewModel.SalesReportViewModel>

@{
    ViewData["Title"] = "Sales Report";
}

<div class="container mt-4">
    <h2>Sales Report</h2>

    <form method="get" class="mb-3">
        <div class="row">
            <div class="col-md-4">
                <label class="form-label">From Date</label>
                <input type="date" name="startDate" class="form-control" value="@ViewContext.HttpContext.Request.Query["startDate"]" />
            </div>
            <div class="col-md-4">
                <label class="form-label">To Date</label>
                <input type="date" name="endDate" class="form-control" value="@ViewContext.HttpContext.Request.Query["endDate"]" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary">Generate Report</button>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Total Amount</th>
                    <th>Discount</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.OrderId</td>
                        <td>@item.CustomerName</td>
                        <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.TotalAmount.ToString("C")</td>
                        <td>@item.Discount.ToString("C")</td>
                        <td>@item.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>