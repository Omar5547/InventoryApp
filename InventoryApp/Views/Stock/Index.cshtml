@model IEnumerable<InventoryApp.ViewModel.StockViewModel>  
@{  
    ViewData["Title"] = " Stock";  
}  
<div class="container mt-4">  
    <h2>Stock</h2>  
    <a asp-action="Index" class="btn btn-secondary mb-3">  
        Back To All Stocks  
    </a>  
    <form method="get" class="mb-3">  
        <div class="input-group">  
            <input type="text" name="search" class="form-control" placeholder="Search by product name or location." value="@Context.Request.Query["search"]" />  
            <button type="submit" class="btn btn-outline-secondary">Search</button>  
        </div>  
    </form>  
    <div class="table-responsive">  
        <table class="table table-striped table-hover">  
            <thead class="table-dark">  
                <tr>  
                    <th>Product Name</th>  
                    <th>Location</th>  
                    <th>Quantity</th>  
                    <th>Last Updated</th>  
                </tr>  
            </thead>  
            <tbody>  
                @foreach (var item in Model)  
                {  
                    <tr>
                        <td>@item.productName</td>
                        <td>@item.locationName</td>  
                        <td>@item.Qty.ToString("N2")</td>  
                    </tr>  
                }  
            </tbody>  
        </table>  
    </div>  
</div>