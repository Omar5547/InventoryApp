@model InventoryApp.ViewModel.ProductViewModel

@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="col-lg-4 col-md-6 portfolio-item isotope-item _@Model.CategoryName">
    <div class="portfolio-content h-100">
        <a href="@Model.ImageUrl" data-gallery="portfolio-gallery-app" class="glightbox">
            <img src="https://localhost:54538/upload/@Model.ImageUrl" class="img-fluid" alt="@Model.Name">
        </a>

        <div class="portfolio-info">
            <h4>@Model.Name</h4>
            <p>@Model.SalePrice</p>
        </div>

        <center>
            <!-- ✔️ اللينك الصحيح -->
            <a asp-controller="Order"
               asp-action="AddToCart"
               asp-route-productId="@Model.Id"
               asp-route-quantity="1"
               asp-route-returnUrl="@returnUrl"
               class="btn btn-success">
                اضافة الي السلة
                <i class="bi bi-plus"></i>
            </a>

            <a asp-controller="Product" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Details</a>
            <a asp-controller="Product" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
        </center>
    </div>
</div>
