@model InventoryApp.ViewModel.ProductViewModel
@{
    ViewData["Title"] = "Delete Product";
}
<div class="container mt-4">
    <h2 >Delete Product</h2>
    <div class="alert alert-danger">
       
    <h4 class="text-danger mb-4">Are you sure you want to delete this product?</h4>
        <hr />




    <dl class="row">
            <dt class="col-sm-3">Code</dt>
            <dd class="col-sm-9">@Model.Code</dd>
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.CategoryName</dd>
     <dt class="col-sm-3">Quatity<dt/>
            <dd class="col-sm-9">@Model.Quantity</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            @if (Model.IsActive)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactive</span>
             }
        </dd>

       

       
    </dl>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
