@model IEnumerable<InventoryApp.ViewModel.ProductViewModel>

@{
    ViewData["Title"] = "Products";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Products</h2>
        <p>
            <a asp-action="Create" class="btn btn-primary">+ Add Product</a>
        </p>
    </div>

    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="search" class="form-control" placeholder="Search by Product name" value="@Context.Request.Query["search"]" />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Image</th>
                    <th>Code</th>
                    <th>Name</th>
                     <th>Sale Price</th>
                    <th>Unit</th>
                    <th>Description</th>
                    <th>Quantity</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@Url.Content(item.ImageUrl)" alt="@item.Name" width="50" height="50" style="object-fit:cover;border-radius:6px;" />
                            }
                            else
                            {
                                <span class="text-muted">No Image</span>
                            }
                        </td>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@item.SalePrice.ToString("C")</td>
                        <td>@item.Unit</td>
                        <td>@item.Description</td>
                        <td>@item.Quantity</td>
                        <td>@item.CategoryName</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


    <style>
        .actions
        {
            display : flex;
            gap : 10px;
        }
        .actions.btn{
            padding : 5px 10p;
            font-size : 14px;
            text-align : center ;
        
        }
    </style>
}
