@model IEnumerable<InventoryApp.ViewModel.PurchaseOrderViewModel>
@{
    ViewData["Title"] = " Purchase Orders";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2> Purchase Orders</h2>
        <p>
            <a asp-action="Create" class="btn btn-primary">+ Add New Purchase Order</a>
        </p>
    </div>
    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="search" class="form-control" placeholder="Search by vendor name" value="@Context.Request.Query["search"]" />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
        </div>
    </form>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Order ID</th>
                    <th>Vendor</th>
                    <th>Date</th>
                    <th>Status</th>
                   
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.VendorName</td>
                        <td>@item.OrderDate.ToString()</td>
                        <td>
                            @if (item.Status == Core.Entities.OrderStatus.Open)
                            {
                                <span class="badge bg-warning">Open</span>
                            }
                            else if (item.Status == Core.Entities.OrderStatus.Posted)
                            {
                                <span class="badge bg-success"> Posted</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Canceled</span>
                            }
                        </td>
                        
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                            @if (item.Status == Core.Entities.OrderStatus.Open)
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="get" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this order?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            }
                           
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
