@model PurchaseOrderViewModel
@using System.Globalization
@{
    ViewData["Title"] = $"Purchase Order #{Model.Id}";
    var ci = CultureInfo.CurrentCulture; 
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Purchase Order #@Model.Id</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Vendor</dt>
            <dd class="col-sm-9">@Model.VendorName</dd>

            <dt class="col-sm-3">Order Date</dt>
            <dd class="col-sm-9">@Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.Status == Core.Entities.OrderStatus.Open)
                {
                    <span class="badge bg-warning">Open</span>
                }
                else if (Model.Status == Core.Entities.OrderStatus.Posted)
                {

                    <span class="badge bg-success">Posted</span>
                }
                else
                {

                    <span class="badge bg-danger">Canceled</span>
                }
            </dd>

            <dt class="col-sm-3">Currency</dt>
            <dd class="col-sm-9">@Model.Currency</dd>

            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9">
                @(Model.CreatedAt > DateTime.MinValue ? Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") : "—")
            </dd>

            <dt class="col-sm-3">Updated At</dt>
            <dd class="col-sm-9">
                @(Model.UpdatedAt > DateTime.MinValue ? Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss") : "—")
            </dd>
        </dl>
    </div>
</div>

<h3>Order Items</h3>
<div class="table-responsive">
    <table class="table table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Product Name</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Unit Price</th>
                <th class="text-end">Discount (%)</th>
                <th class="text-end">Tax (%)</th>
                <th class="text-end">Tax Amount</th>
                <th class="text-end">Total (incl. Tax)</th>
            </tr>
        </thead>
        <tbody>
            @{
                decimal subTotalAfterDiscount = 0m;
                decimal totalTax = 0m;
                foreach (var it in Model.Items)
                {
                    
                    var lineBase = it.Qty * it.UnitPrice * (1 - it.Discount / 100m);
                    var lineTaxAmt = lineBase * (it.Tax / 100m);
                    var lineTotalInc = lineBase + lineTaxAmt;

                    subTotalAfterDiscount += lineBase;
                    totalTax += lineTaxAmt;
                    <tr>
                        <td>@it.ProductName</td>
                        <td class="text-end">@it.Qty.ToString("N3", ci)</td>
                        <td class="text-end">@it.UnitPrice.ToString("C", ci)</td>
                        <td class="text-end">@it.Discount.ToString("N2")%</td>
                        <td class="text-end">@it.Tax.ToString("N2")%</td>
                        <td class="text-end">@lineTaxAmt.ToString("C", ci)</td>
                        <td class="text-end fw-semibold">@lineTotalInc.ToString("C", ci)</td>
                    </tr>
                }
                var grand = subTotalAfterDiscount + totalTax;
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="5" class="text-end">Subtotal (after discount):</th>
                <th colspan="2" class="text-end">@subTotalAfterDiscount.ToString("C", ci)</th>
            </tr>
            <tr>
                <th colspan="5" class="text-end">Total Tax:</th>
                <th colspan="2" class="text-end">@totalTax.ToString("C", ci)</th>
            </tr>
            <tr>
                <th colspan="5" class="text-end">Grand Total:</th>
                <th colspan="2" class="text-end text-success">@grand.ToString("C", ci)</th>
            </tr>
        </tfoot>
    </table>
</div>
